# ---------------------------------------------------------------------------
# ArchFlow AI - backend environment
#
# Copy this file to `.env` and fill in the real values.
#   cp .env.example .env
#
# NEVER commit a populated `.env` to Git.
# ---------------------------------------------------------------------------

# Port the Express server listens on.
PORT=5500

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/archflow
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign and verify JWTs.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# AI provider - you only need ONE of these two keys.
# ---------------------------------------------------------------------------

# Groq (RECOMMENDED - free tier, no credit card required).
# Create a key at https://console.groq.com/keys
# Free tier limits: ~30 requests/min, ~1,000 requests/day on gpt-oss-120b.
# Verify it works with:  npm run check:ai
GROQ_API_KEY=

# Optional: override the Groq model. Defaults to openai/gpt-oss-120b.
# Free-tier alternatives: llama-3.3-70b-versatile, llama-3.1-8b-instant
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: force a specific provider ("groq" or "huggingface").
# When unset, the first configured key wins, preferring Groq.
# AI_PROVIDER=groq

# Hugging Face access token - only needed if you have funded credits.
# The free Inference Providers tier returns "no remaining credits".
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Comma-separated list of browser origins allowed by CORS.
# Use the deployed frontend URL in production, and "*" only for local testing.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Set to "production" on Render. Suppresses stack traces in error responses.
NODE_ENV=development
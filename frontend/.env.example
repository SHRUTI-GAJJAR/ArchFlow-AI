# ---------------------------------------------------------------------------
# ArchFlow AI - frontend environment
#
# Copy this file to `.env` and fill in the real values.
#   cp .env.example .env
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put a secret here - everything in this file ends up in the client.
# ---------------------------------------------------------------------------

# Base URL of the backend API, including the /api prefix.
# Local:  http://localhost:5500/api
# Prod:   https://archflow-ai-hj5p.onrender.com/api
VITE_API_URL=http://localhost:5500/api